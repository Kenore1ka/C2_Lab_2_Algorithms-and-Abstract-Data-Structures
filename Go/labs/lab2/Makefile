# Команда для запуска Go
GOCMD=go

# Команда для сборки Go-проекта
GOBUILD=$(GOCMD) build

# Имя итоговой программы
BINARY_NAME=lab2
# Директория для скомпилированных файлов
BUILD_DIR=../../build/lab2

# Полный путь к исполняемому файлу
TARGET=$(BUILD_DIR)/$(BINARY_NAME)

# Правило по умолчанию: собрать всё
all: build

# Правило для сборки исполняемого файла
# Зависит от всех .go файлов в текущей директории
# `go build` автоматически найдет и скомпилирует все необходимые файлы
build: *.go
	@echo "Сборка $(BINARY_NAME)..."
	@mkdir -p $(BUILD_DIR)
	$(GOBUILD) -o $(TARGET) .
	@echo "Сборка $(BINARY_NAME) завершена."

# Правило для очистки
# Удаляет директорию сборки
clean:
	@echo "Очистка..."
	@rm -rf $(BUILD_DIR)
	@echo "Очистка завершена."

# Правило для запуска программы
# Сначала собирает проект, потом запускает
run: build
	@echo "Запуск $(BINARY_NAME)..."
	./$(TARGET)

# Указываем, что эти цели не являются файлами
.PHONY: all build clean run